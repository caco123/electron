{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "com.tuapp.electron",
  "productName": "MiAplicacion",
  "directories": {
    "output": "release"
  },
  "files": [
    "**/*",
    "!electron-builder*.json",
    "../dist/electron/**/*",
    "../package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": false,
    "include": "installer.nsh"
  }
}