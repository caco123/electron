{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "com.tuapp.electron",
  "productName": "MiAplicacion",
  "directories": {
    "output": "../release"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}